<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionStepCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/cardBackground"
    app:cardCornerRadius="12dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header: Step Badge + Action Selector + Reorder / Remove buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stepNumberBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/flow_chip_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                tools:text="Step 1" />

            <TextView
                android:id="@+id/actionTypeSelector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/ic_keyboard_arrow_down_black_24dp"
                tools:text="Forward via SMS" />

            <ImageButton
                android:id="@+id/btnMoveUp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_keyboard_arrow_up_black_24dp"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/automation_move_up" />

            <ImageButton
                android:id="@+id/btnMoveDown"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_keyboard_arrow_down_black_24dp"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/automation_move_down" />

            <ImageButton
                android:id="@+id/btnRemoveStep"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_close_black_24dp"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/automation_remove_step" />

        </LinearLayout>

        <!-- Inset Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- ── Forward SMS Section ── -->
        <LinearLayout
            android:id="@+id/forwardSmsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automation_forward_phone_hint"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/forwardPhoneField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/automation_forward_phone_hint"
                    android:inputType="phone"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btnPickContact"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_person_black_24dp"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="@string/automation_pick_contact"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/automation_append_sender"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                    android:textColor="?android:attr/textColorPrimary" />

                <dev.octoshrimpy.quik.common.widget.QkSwitch
                    android:id="@+id/appendSenderSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Forward HTTP Section ── -->
        <LinearLayout
            android:id="@+id/forwardHttpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automation_forward_http_title"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/forwardUrlField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/automation_forward_url_hint"
                android:inputType="textUri"
                android:maxLines="1" />

        </LinearLayout>

        <!-- ── Auto-reply Section ── -->
        <LinearLayout
            android:id="@+id/autoReplyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automation_auto_reply_title"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/replyTemplateField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/automation_reply_template_hint"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/automation_reply_template_hint_detail"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- ── Simple Info Section (Delete, Archive, Mark Read) ── -->
        <TextView
            android:id="@+id/stepDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="Permanently delete the incoming message." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
